{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Kairos \u2014 server overview",
  "uid": "kairos-overview",
  "tags": [
    "kairos"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Request latency by endpoint",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(kairos_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p50 {{route}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(kairos_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p95 {{route}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(kairos_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p99 {{route}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Quantiles interpolated from histogram buckets. Good enough to alert on; use the query log to chase one slow request."
    },
    {
      "id": 2,
      "title": "Throughput",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(kairos_http_requests_total[5m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Error rate",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(kairos_http_errors_total[5m])) / clamp_min(sum(rate(kairos_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Connection budget",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "kairos_pg_connections_allocated",
          "legendFormat": "allocated",
          "refId": "A"
        },
        {
          "expr": "kairos_pg_connection_budget",
          "legendFormat": "budget",
          "refId": "B"
        },
        {
          "expr": "kairos_pg_pools",
          "legendFormat": "open pools",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "When allocated approaches budget, new project pools are refused rather than exhausting PostgreSQL."
    },
    {
      "id": 5,
      "title": "Clients waiting for a connection",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "kairos_pg_clients_waiting",
          "legendFormat": "waiting",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "The number that predicts an outage. A pool at capacity is fine until something queues behind it."
    },
    {
      "id": 6,
      "title": "Host CPU and temperature",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "kairos_cpu_usage_percent",
          "legendFormat": "cpu %",
          "refId": "A"
        },
        {
          "expr": "kairos_cpu_temperature_celsius",
          "legendFormat": "\u00b0C",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Above ~85\u00b0C a laptop throttles. Queries look slow for reasons that have nothing to do with their plans."
    },
    {
      "id": 7,
      "title": "Memory and disk",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "100 * kairos_memory_used_bytes / kairos_memory_total_bytes",
          "legendFormat": "memory %",
          "refId": "A"
        },
        {
          "expr": "100 * kairos_disk_used_bytes / kairos_disk_total_bytes",
          "legendFormat": "disk %",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "description": "PostgreSQL refuses writes when the data volume fills. Uploads and backups fail before it does."
    },
    {
      "id": 8,
      "title": "Redis",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "kairos_redis_hit_ratio",
          "legendFormat": "hit ratio",
          "refId": "A"
        },
        {
          "expr": "kairos_redis_memory_bytes",
          "legendFormat": "memory",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Things needing attention",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "kairos_backups_unverified",
          "legendFormat": "unverified backups",
          "refId": "A"
        },
        {
          "expr": "kairos_quota_violations_total",
          "legendFormat": "quota refusals (1h)",
          "refId": "B"
        },
        {
          "expr": "kairos_webhook_failures_total",
          "legendFormat": "webhook failures (1h)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "An unverified backup is not a backup. This panel exists so that fact is visible before it matters."
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
