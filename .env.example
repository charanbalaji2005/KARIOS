# ---- Platform database (control plane) ----
DATABASE_URL=postgres://kairos:kairos@localhost:5432/kairos_platform
# Superuser connection used ONLY by the provisioner to CREATE DATABASE / CREATE ROLE
PROVISIONER_URL=postgres://postgres:postgres@localhost:5432/postgres
# Host/port handed to users in their project connection strings
PROJECT_DB_HOST=localhost
PROJECT_DB_PORT=5432

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Secrets (generate with: openssl rand -hex 32) ----
JWT_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

# ---- Object storage (MinIO / S3) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=kairosadmin
S3_SECRET_KEY=kairosadmin123
S3_FORCE_PATH_STYLE=true

# ---- URLs ----
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Mail (optional in dev; logged to console when unset) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@kairosdb.local

PORT=4000
LOG_LEVEL=info
NODE_ENV=development

# ---- Security / edge (see infrastructure/) ----
# Number of reverse proxies in front of the API. 0 = direct, 1 = behind nginx,
# 2 = behind Cloudflare + nginx. Too high and clients can spoof their own IP
# via X-Forwarded-For, dodging rate limits and getting others banned.
TRUST_PROXY_HOPS=0

# Plain-text security event log that fail2ban tails.
SECURITY_LOG_PATH=/var/log/kairos/security.log

# Where the laptop keeps project data (used by the server metrics page).
KAIROS_DATA_ROOT=/var/lib/kairos

# ---- Production only (docker-compose.prod.yml) ----
# Generate all of these with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
REDIS_PASSWORD=

# Cloudflare Tunnel, if you use the `tunnel` profile instead of open ports.
TUNNEL_TOKEN=

# Offsite backup target for the `offsite` profile (rclone remote name).
OFFSITE_TYPE=s3
OFFSITE_BUCKET=kairos-backups

TZ=UTC

# ---- Storage driver ----
# local = the laptop's own disk under KAIROS_DATA_ROOT/storage (default)
# s3    = MinIO / AWS S3 / Cloudflare R2 (S3_* vars above are then required)
STORAGE_DRIVER=local

# ---- Resource quotas (per project) ----
# The laptop is shared. Without ceilings, one project's bulk import fills the
# disk and every other project stops accepting writes. Leave a value unset to
# use the default; set it to raise or lower the ceiling for new projects.
QUOTA_DATABASE_BYTES=5368709120
QUOTA_STORAGE_BYTES=10737418240
QUOTA_MAX_FILE_BYTES=52428800
QUOTA_MAX_CONNECTIONS=20
QUOTA_MAX_TABLES=200
QUOTA_API_REQUESTS_PER_HOUR=100000
QUOTA_REALTIME_CONNECTIONS=50
QUOTA_BACKGROUND_JOBS_PER_DAY=500

# How often the worker re-measures per-project usage. Quotas for database and
# storage size are enforced against the last sample, so a longer interval means
# a project can overshoot by more before it is stopped.
USAGE_SAMPLE_INTERVAL_MS=300000

# Comma-separated emails allowed to RAISE quotas. A project owner who can lift
# their own limits has no limits, so this is deliberately not a project role.
# Empty means nobody can change quotas through the API.
PLATFORM_OPERATORS=

# ---- Outbound request protection (webhooks) ----
# Exact hostnames allowed to resolve privately, for a deliberate LAN webhook.
# Exact matches only — no wildcards.
WEBHOOK_ALLOWED_HOSTS=
# Allow plain http webhook URLs. Off by default: a signed payload in clear text
# over someone else's network defeats the signature.
WEBHOOK_ALLOW_HTTP=false

# ---- Connection budget ----
# Must be <= PostgreSQL's max_connections. The reserve is held back for the
# platform database, realtime listeners, workers and a human with psql.
PG_CONNECTION_BUDGET=300
PG_PLATFORM_RESERVE=60
PG_MIN_POOL=2
PG_MAX_POOL=10

# ---- Backups ----
# Deep verification restores each backup into a scratch database and queries it.
# The only check that proves a backup is usable; costs a full restore.
BACKUP_DEEP_VERIFY=false

# ---- Network mode ----
# local  = loopback only
# lan    = reachable from your network (phone on the same wifi)
# remote = reachable via tunnel or VPN
KAIROS_NETWORK_MODE=local
# Extra browser origins allowed to call the dashboard API, comma separated.
ADDITIONAL_ORIGINS=

# ---- OAuth (optional) ----
# Leave blank to hide the buttons. Local email/password auth always works —
# the server must not depend on an external provider being reachable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Callback URLs to register with each provider:
#   {API_URL}/api/v1/auth/oauth/google/callback
#   {API_URL}/api/v1/auth/oauth/github/callback

# ---- Import limits ----
MAX_IMPORT_ROWS=50000

# ---------------------------------------------------------------------------
# Server agent
#
# The privileged component that manages the Ubuntu host. Created by
# scripts/install-server.sh; leave these unset on a development checkout and
# the server console will simply report "not a server install".
#
# See docs/SERVER-CONSOLE.md.
# ---------------------------------------------------------------------------

# Where the agent listens. A socket path, not a port: the agent is deliberately
# not reachable over the network at all.
KAIROS_AGENT_SOCKET=/run/kairos/server-agent.sock

# The shared secret the API signs agent requests with. Prefer the file — an
# environment variable is readable in /proc/<pid>/environ by anything running
# as the same user and gets copied into crash dumps.
KAIROS_AGENT_TOKEN_FILE=/etc/kairos/agent.token
# KAIROS_AGENT_TOKEN=

# Loopback fallback, for an API in a container that cannot see the host's
# filesystem. Leave unset unless you need it. 127.0.0.1 only, on both ends.
# KAIROS_AGENT_TCP_PORT=4100

# How long an "Enable Ubuntu Terminal" grant lasts before expiring on its own,
# and how recently the operator must have signed in to create one.
KAIROS_UBUNTU_TERMINAL_TTL_MINUTES=30
KAIROS_RECENT_AUTH_MINUTES=15

# Accounts allowed to administer the host, by email, as a comma-separated list.
# This exists so the first operator can exist before anyone has logged in to
# grant it. Prefer setting users.is_platform_admin once you have.
# PLATFORM_OPERATORS=you@example.com
