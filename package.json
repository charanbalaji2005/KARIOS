{
  "name": "kairosdb",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "kairos": "pnpm --filter @kairosdb/cli dev",
    "kairosdb": "pnpm --filter @kairosdb/cli dev",
    "db:migrate": "pnpm --filter @kairosdb/api migrate",
    "db:seed": "pnpm --filter @kairosdb/api seed",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "security:verify": "./scripts/verify-security.sh",
    "security:firewall": "sudo ./infrastructure/firewall/ufw-setup.sh",
    "backup:run": "./scripts/backup-rotate.sh",
    "nginx:test": "docker compose -f docker-compose.prod.yml exec nginx nginx -t",
    "nginx:reload": "docker compose -f docker-compose.prod.yml exec nginx nginx -s reload",
    "bench": "pnpm --filter @kairosdb/tests bench",
    "pg:tune": "./scripts/tune-postgres.sh",
    "test:unit": "pnpm --filter @kairosdb/tests exec vitest run integration/quotas.test.ts integration/sql-guard.test.ts",
    "e2e": "pnpm --filter @kairosdb/tests e2e",
    "test:security": "pnpm --filter @kairosdb/tests test:security",
    "bench:load": "pnpm --filter @kairosdb/tests bench:load",
    "agent:dev": "pnpm --filter @kairosdb/server-agent dev",
    "agent:build": "pnpm --filter @kairosdb/server-agent build",
    "server:install": "sudo ./scripts/install-server.sh",
    "server:install:dry": "./scripts/install-server.sh --dry-run",
    "server:uninstall": "sudo ./scripts/uninstall-server.sh",
    "server:status": "pnpm --filter @kairosdb/cli dev server status",
    "server:doctor": "pnpm --filter @kairosdb/cli dev server doctor"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "prettier": "^3.3.3"
  }
}
